[Unit]
Description=EdgeGuard dashboard
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/edgeguard/settings
ExecStart=/usr/bin/python3 /opt/edgeguard/dashboard.py ${DEVICE} ${WEB} ${PORT}
DynamicUser=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
